# Tellybox settings. Save this file as ".env" next to docker-compose.yml.

# Your time zone: the daily reset (04:00) and the history use it. Change this one.
TZ=Europe/Amsterdam

# The web app, reachable from your LAN (the Chromecast too). Change it if the port is taken.
TELLYBOX_WEB_PORT=8080
# Internal API, localhost only. Change it if the port is taken.
TELLYBOX_CAST_API_PORT=8081

# The user and group the services run as. The folders are created and owned by them.
PUID=1500
PGID=1500

# Pin a version instead of following the newest release (see "Updating").
# TELLYBOX_TAG=0.1

# Only if autodetection picks the wrong network interface: how the Chromecast reaches the server.
# TELLYBOX_MEDIA_BASE_URL=http://192.168.1.10:8080

# Optional. Without it, you choose the admin password in the browser, with a setup code from the log.
# TELLYBOX_ADMIN_PASSWORD=

# Optional: sign in to the admin with an OpenID Connect provider too (see "Sign in with OIDC").
# The password stays, and only members of the group get in. Leave the secret empty for a public client.
# TELLYBOX_OIDC_ISSUER=https://id.example.org
# TELLYBOX_OIDC_CLIENT_ID=tellybox
# TELLYBOX_OIDC_CLIENT_SECRET=
# TELLYBOX_OIDC_REDIRECT_URI=https://tellybox.example.org/admin/oidc/callback
# TELLYBOX_OIDC_ADMIN_GROUP=tellybox-admins
