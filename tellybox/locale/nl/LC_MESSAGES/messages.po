msgstr "Delen"

#: tellybox/web/admin/templates/split.html:113
msgid "Delete the original video after cutting (it can't be split again)"
msgstr "Verwijder de originele video na het knippen (hij kan dan niet opnieuw worden opgeknipt)"

#: tellybox/web/admin/templates/split.html:116
msgid "Approve and cut"
msgstr "Goedkeuren en knippen"

#: tellybox/web/admin/templates/split.html:120
