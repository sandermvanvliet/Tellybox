msgid "Type \"%(word)s\" to confirm"
msgstr "Typ \"%(word)s\" om te bevestigen"

#: tellybox/web/admin/templates/show.html:237
msgid "Delete episode and its files"
msgstr "Aflevering en bestanden verwijderen"

#: tellybox/web/admin/templates/split.html:14
msgid "Hidden from the kids until you approve the split"
msgstr "Verborgen voor de kinderen tot je het opknippen goedkeurt"

#: tellybox/web/admin/templates/split.html:15
msgid "This long video was downloaded for splitting. Approve a split below, or publish it as one video."
msgstr "Deze lange video is gedownload om op te knippen. Keur hieronder een knipplan goed, of geef hem vrij als één video."

#: tellybox/web/admin/templates/split.html:17
msgid "Publish as one video"
msgstr "Vrijgeven als één video"

#: tellybox/web/admin/templates/split.html:22
msgid "The split editor needs JavaScript."
msgstr "De knipeditor heeft JavaScript nodig."

#: tellybox/web/admin/templates/split.html:30
msgid "Cutting…"
msgstr "Bezig met knippen…"

#: tellybox/web/admin/templates/split.html:31
msgid "The video is cut into parts in the background. You can leave this page."
msgstr "De video wordt op de achtergrond in delen geknipt. Je kunt deze pagina verlaten."

#: tellybox/web/admin/templates/split.html:36
msgid "Splitting failed"
msgstr "Opknippen mislukt"

#: tellybox/web/admin/templates/split.html:38
msgid "The existing episodes are unchanged. Check the plan and approve it again."
msgstr "De bestaande afleveringen zijn niet veranderd. Controleer het plan en keur het opnieuw goed."

#: tellybox/web/admin/templates/split.html:42
#, python-format
msgid "Split into %(num)d episode"
msgid_plural "Split into %(num)d episodes"
msgstr[0] "Opgeknipt in %(num)d aflevering"
msgstr[1] "Opgeknipt in %(num)d afleveringen"

#: tellybox/web/admin/templates/split.html:46
msgid "Change the plan below to split it again."
msgstr "Pas het plan hieronder aan om hem opnieuw op te knippen."

